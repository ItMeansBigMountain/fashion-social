# Automatically injected by the connected Neon/Vercel Marketplace resource.
DATABASE_URL=
# Stripe secret key (use sk_test_... while testing).
STRIPE_SECRET_KEY=
# Stripe webhook signing secret, generated when the webhook endpoint is created.
STRIPE_WEBHOOK_SECRET=
# Canonical deployment URL.
NEXT_PUBLIC_SITE_URL=https://fashion-social-app.vercel.app
# Long random value used to sign anonymous voter cookies (already provisioned in Vercel).
VOTE_COOKIE_SECRET=
# Long random bearer secret used by the hourly creator fulfillment/refund watchdog.
CRON_SECRET=
# Optional provider keys. Core manual shipping and social moderation work without them.
SHIPPO_API_TOKEN=
INSTAGRAM_ACCESS_TOKEN=
TIKTOK_ACCESS_TOKEN=
YOUTUBE_API_KEY=
PINTEREST_ACCESS_TOKEN=
